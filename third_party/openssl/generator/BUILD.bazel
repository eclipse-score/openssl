load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files(glob(["patches/*.patch"]))

sh_binary(
    name = "generate",
    srcs = ["generate.sh"],
    args = [
        "$(rlocationpath @openssl_generator//:README.md)",
        "$(rlocationpath @openssl_release//:VERSION.dat)",
        "$(rlocationpath //third_party/openssl/config:openssl_config.json)",
    ],
    data = [
        "//third_party/openssl/config:openssl_config.json",
        "@openssl_generator//:README.md",
        "@openssl_release//:VERSION.dat",
    ],
)
